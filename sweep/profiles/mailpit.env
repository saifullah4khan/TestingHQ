# Profile for `sweep/run.sh mailpit`: a local Mailpit and the demo pipeline,
# both on loopback, so the readback answers in milliseconds.
SWEEP_MAX_WAIT=60
SWEEP_QUIET_WINDOW=3
SWEEP_READBACK_RATE=50
# The reference run fires TestingHQ's own corpus only. Set 1 to also fire
# Zammad's mail corpus, cloned into sweep/.cache at run time.
SWEEP_CORPUS=0
SWEEP_BARRAGE=1
SWEEP_HEALTH_URL=http://127.0.0.1:8025/readyz
# Mailpit holds messages, not tickets, so of redeliver's four scenarios the two
# that count copies apply (see examples/readback/mailpit.toml). The pipeline
# deduplicates on Message-ID whatever the gap, so a short retry wait will do.
SWEEP_ARGS_REDELIVER=--scenario duplicate --scenario slow-retry --retry-after 5
