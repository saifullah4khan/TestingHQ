SWEEP_MAX_WAIT=600
SWEEP_QUIET_WINDOW=150
SWEEP_CORPUS=1
SWEEP_BARRAGE=1
SWEEP_HEALTH_URL=http://127.0.0.1:3500/api/method/ping
SWEEP_EXPECT_ROUTE=Sweep Support
# redeliver's threading scenarios share their payloads, and at seed 0 the
# thread's original carries a JPEG that Frappe fails to save (Pillow raises
# on it), losing the whole message, which verify and ledger already report.
# Seed 7's thread carries no attachment, so redeliver answers its own
# question: duplicates and threading.
SWEEP_ARGS_REDELIVER=--seed 7
