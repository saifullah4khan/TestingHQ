# Chatwoot routes inbound mail as it arrives: the ingress stores it and a
# sidekiq job files it within seconds, so the waits are short. They allow for
# the readback's own pace (each lookup is a page and an empty next page at 4
# requests a second) on the larger runs.
SWEEP_MAX_WAIT=300
SWEEP_QUIET_WINDOW=15
# The corpus goes over the same HTTP ingress. Its addresses are rewritten to
# corpus.example.test, which is no inbox, but the target's envelope_to puts
# the sweep inbox's forwarding address in X-Original-To, so it is filed there.
SWEEP_CORPUS=1
SWEEP_BARRAGE=1
SWEEP_HEALTH_URL=http://127.0.0.1:3100/api
# The inbox id every message should be filed under (readback field route).
SWEEP_EXPECT_ROUTE=1
