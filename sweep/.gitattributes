# Bash reads these under Git Bash on Windows too, where a CRLF checkout breaks
# every line. Keep them LF whatever core.autocrlf says.
*.sh text eol=lf
*.env text eol=lf
*.yml text eol=lf
# The Dovecot configs are read by a Linux daemon in a container, from a
# bind mount of the checkout. Dovecot happens to accept CRLF, but nothing
# should depend on that.
*.conf text eol=lf
