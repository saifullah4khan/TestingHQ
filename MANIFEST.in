# What goes in the sdist. The wheel carries only the importable package; the
# sdist adds what a reader of the source needs: the changelog, the docs and
# the example configs.
#
# The test suite is not shipped. It needs the repository (CI workflows, git,
# the e2e harness), so from an extracted sdist it could not pass, and a suite
# that fails out of the box is worse than none. Clone the repository to run it.

include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include README.md

recursive-include docs *.md
recursive-include examples *.toml *.py *.md
recursive-include examples/runs *.json *.html

# The helpdesk sweep (sweep/README.md). It drives Docker from a checkout, so it
# is source only: in the sdist, never in the wheel. The credentials a setup
# script writes, the run artifacts and the download cache stay out.
graft sweep
prune sweep/runs
prune sweep/.cache
prune sweep/.state
exclude sweep/.env.*
global-exclude __pycache__ *.py[cod]

prune tests
prune .github
